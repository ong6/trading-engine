[Unit]
Description=Capture bounded Massive option contracts and daily bars
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/.venv/bin/python -m tools.free_massive_options
Environment=PYTHONUNBUFFERED=1
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
