[Unit]
Description=Trading engine hourly operations digest

[Service]
Type=oneshot
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/.venv/bin/python -m tools.ops_digest
Environment=PYTHONUNBUFFERED=1
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=10min
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
