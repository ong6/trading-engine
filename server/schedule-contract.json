{
  "version": 1,
  "about": "Every user unit, timer and cron line on the engine host, the live store files each may hold and when. Checked by tools.schedule_contract_check (--static in tests, --live hourly in the ops digest). Paths are relative to the live checkout (engine) or the home directory (home). Times are wall clock in the zone named; windows: schedule = each scheduled start plus window_minutes (default max_runtime + 5 min).",
  "lane_path_markers": ["/engine-lanes/", "/alpha-lanes/", "/.tae/", "/worktrees/"],
  "audited_databases": ["store/market.duckdb", "store/pit/*.duckdb"],
  "host_units": [
    {"pattern": "at-spi-dbus-bus.service", "reason": "desktop session accessibility bus"},
    {"pattern": "dbus.*", "reason": "user message bus"},
    {"pattern": "dirmngr.*", "reason": "GnuPG helper"},
    {"pattern": "gpg-agent*", "reason": "GnuPG agent"},
    {"pattern": "ssh-agent.service", "reason": "ssh agent"},
    {"pattern": "glib-pacrunner.service", "reason": "desktop proxy helper"},
    {"pattern": "ipAddressEnv-user.service", "reason": "host-mandated environment unit"},
    {"pattern": "systemd-*", "reason": "systemd user housekeeping"}
  ],
  "units": [
    {"unit": "trading-engine-api.service", "origin": "repo", "source": "server/trading-engine-api.service",
     "state": "enabled", "activation": "boot", "max_runtime": null,
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "always"}},
    {"unit": "trading-engine-ui.service", "origin": "repo", "source": "ui/trading-engine-ui.service",
     "state": "enabled", "activation": "boot", "max_runtime": null,
     "store": {"access": "none"}},

    {"unit": "trading-engine-agent-data-capture.timer", "origin": "repo",
     "source": "server/trading-engine-agent-data-capture.timer", "state": "enabled",
     "service": "trading-engine-agent-data-capture.service",
     "calendar": ["Tue..Sat *-*-* 01:25:00 UTC"]},
    {"unit": "trading-engine-agent-data-capture.service", "origin": "repo",
     "source": "server/trading-engine-agent-data-capture.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-agent-data-capture.timer", "max_runtime": "10min",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "trading-engine-agent-shadow.timer", "origin": "repo",
     "source": "server/trading-engine-agent-shadow.timer", "state": "enabled",
     "service": "trading-engine-agent-shadow.service",
     "calendar": ["Tue..Sat *-*-* 01:30:00 UTC"]},
    {"unit": "trading-engine-agent-shadow.service", "origin": "repo",
     "source": "server/trading-engine-agent-shadow.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-agent-shadow.timer", "max_runtime": "5min",
     "window_minutes": 30,
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "trading-engine-daily-opportunity.timer", "origin": "repo",
     "source": "server/trading-engine-daily-opportunity.timer", "state": "enabled",
     "service": "trading-engine-daily-opportunity.service",
     "calendar": ["Tue..Sat *-*-* 02:00:00 UTC"]},
    {"unit": "trading-engine-daily-opportunity.service", "origin": "repo",
     "source": "server/trading-engine-daily-opportunity.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-daily-opportunity.timer", "max_runtime": "10min",
     "window_minutes": 45,
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "trading-engine-hourly-opportunity.timer", "origin": "repo",
     "source": "server/trading-engine-hourly-opportunity.timer", "state": "enabled",
     "service": "trading-engine-hourly-opportunity.service",
     "calendar": ["Mon..Fri *-*-* 10..16:15:00 America/New_York"]},
    {"unit": "trading-engine-hourly-opportunity.service", "origin": "repo",
     "source": "server/trading-engine-hourly-opportunity.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-hourly-opportunity.timer", "max_runtime": "10min",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "trading-engine-four-hour-opportunity.timer", "origin": "repo",
     "source": "server/trading-engine-four-hour-opportunity.timer", "state": "enabled",
     "service": "trading-engine-four-hour-opportunity.service",
     "calendar": ["Mon..Fri *-*-* 10:30:00 America/New_York", "Mon..Fri *-*-* 13:30:00 America/New_York"]},
    {"unit": "trading-engine-four-hour-opportunity.service", "origin": "repo",
     "source": "server/trading-engine-four-hour-opportunity.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-four-hour-opportunity.timer", "max_runtime": "10min",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "trading-engine-tradingview-history.timer", "origin": "repo",
     "source": "server/trading-engine-tradingview-history.timer", "state": "disabled",
     "reason": "collection paused by server/collection-policy.json (revision 16): no reader of TradingView daily history; re-enable both together",
     "service": "trading-engine-tradingview-history.service",
     "calendar": ["Mon..Fri *-*-* 03,07,11,21,23:40:00 UTC", "Sat *-*-* 03,07,11,15,19,23:40:00 UTC",
                  "Sun *-*-* 01,03,11,15,19,23:40:00 UTC"]},
    {"unit": "trading-engine-tradingview-history.service", "origin": "repo",
     "source": "server/trading-engine-tradingview-history.service", "state": "disabled",
     "reason": "disabled with its timer",
     "activation": "timer", "timer": "trading-engine-tradingview-history.timer", "max_runtime": "4h",
     "window_minutes": 255,
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "trading-engine-p15-scoring.timer", "origin": "repo",
     "source": "server/trading-engine-p15-scoring.timer", "state": "enabled",
     "service": "trading-engine-p15-scoring.service",
     "calendar": ["Tue..Sat *-*-* 02:30:00 UTC"]},
    {"unit": "trading-engine-p15-scoring.service", "origin": "repo",
     "source": "server/trading-engine-p15-scoring.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-p15-scoring.timer", "max_runtime": "9h",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "trading-engine-p15-preopen.timer", "origin": "repo",
     "source": "server/trading-engine-p15-preopen.timer", "state": "enabled",
     "service": "trading-engine-p15-preopen.service",
     "calendar": ["Mon..Fri *-*-* 09:05:00 America/New_York"]},
    {"unit": "trading-engine-p15-preopen.service", "origin": "repo",
     "source": "server/trading-engine-p15-preopen.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-p15-preopen.timer", "max_runtime": "20min",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "trading-engine-p15-events.timer", "origin": "repo",
     "source": "server/trading-engine-p15-events.timer", "state": "enabled",
     "service": "trading-engine-p15-events.service",
     "calendar": ["Mon..Fri *-*-* 09:35,50:00 America/New_York", "Mon..Fri *-*-* 10..15:05,20,35,50 America/New_York"]},
    {"unit": "trading-engine-p15-events.service", "origin": "repo",
     "source": "server/trading-engine-p15-events.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-p15-events.timer", "max_runtime": "14min",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "massive-options-daily.timer", "origin": "repo", "source": "server/massive-options-daily.timer",
     "state": "held", "reason": "the provider rejects the splits page bound and option daily bars return status invalid; Persistent=true would fire at once",
     "service": "massive-options-daily.service", "calendar": ["*-*-* 11:35:00 UTC"]},
    {"unit": "massive-options-daily.service", "origin": "repo", "source": "server/massive-options-daily.service",
     "state": "held", "reason": "held with its timer",
     "activation": "timer", "timer": "massive-options-daily.timer", "max_runtime": "3h",
     "store": {"access": "writer", "writes": ["store/pit/options.duckdb", "store/pit/free-sources.duckdb"],
               "reads": [], "windows": "schedule"}},

    {"unit": "trading-engine-accounts-settle.timer", "origin": "repo",
     "source": "server/trading-engine-accounts-settle.timer", "state": "enabled",
     "service": "trading-engine-accounts-settle.service",
     "calendar": ["Tue..Sat *-*-* 07:45:00 UTC", "Tue..Sat *-*-* 11:55:00 UTC"]},
    {"unit": "trading-engine-accounts-settle.service", "origin": "repo",
     "source": "server/trading-engine-accounts-settle.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-accounts-settle.timer", "max_runtime": "30min",
     "store": {"access": "writer", "writes": ["store/market.duckdb"],
               "reads": ["store/pit/free-sources.duckdb", "store/pit/massive-minute.duckdb", "store/pit/short-data.duckdb"],
               "windows": "schedule"}},

    {"unit": "trading-engine-ops-digest.timer", "origin": "repo",
     "source": "server/trading-engine-ops-digest.timer", "state": "enabled",
     "service": "trading-engine-ops-digest.service", "calendar": ["*-*-* *:08:00 UTC"]},
    {"unit": "trading-engine-ops-digest.service", "origin": "repo",
     "source": "server/trading-engine-ops-digest.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-ops-digest.timer", "max_runtime": "10min",
     "store": {"access": "none"}},

    {"unit": "trading-engine-publish-on-change.timer", "origin": "repo",
     "source": "server/trading-engine-publish-on-change.timer", "state": "enabled",
     "service": "trading-engine-publish-on-change.service", "calendar": ["*-*-* *:12,42:00 UTC"]},
    {"unit": "trading-engine-publish-on-change.service", "origin": "repo",
     "source": "server/trading-engine-publish-on-change.service", "state": "enabled",
     "activation": "timer", "timer": "trading-engine-publish-on-change.timer", "max_runtime": "25min",
     "store": {"access": "reader", "reads": ["store/market.duckdb"], "writes": [],
               "windows": "schedule"}},

    {"unit": "trading-engine-p16-challengers.timer", "origin": "repo",
     "source": "server/trading-engine-p16-challengers.timer", "state": "disabled",
     "reason": "registered by P16 but not autostarted; enabling it is an orchestrator decision",
     "service": "trading-engine-p16-challengers.service", "calendar": ["Tue..Sat *-*-* 03:00:00 UTC"]},
    {"unit": "trading-engine-p16-challengers.service", "origin": "repo",
     "source": "server/trading-engine-p16-challengers.service", "state": "disabled",
     "reason": "disabled with its timer",
     "activation": "timer", "timer": "trading-engine-p16-challengers.timer", "max_runtime": "9h",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "massive-daily.timer", "origin": "external", "managed_by": "operator", "state": "enabled",
     "service": "massive-daily.service", "calendar": ["*-*-* 07:10:00 UTC", "*-*-* 11:20:00 UTC"]},
    {"unit": "massive-daily.service", "origin": "external", "managed_by": "operator", "state": "enabled",
     "activation": "timer", "timer": "massive-daily.timer", "max_runtime": "20min",
     "store": {"access": "writer", "writes": ["store/pit/free-sources.duckdb"], "reads": [], "windows": "schedule"}},

    {"unit": "trading-data-backup.timer", "origin": "external", "managed_by": "trading-data", "state": "enabled",
     "service": "trading-data-backup.service", "calendar": ["*-*-* 04:30:00 UTC", "*-*-* 10:30:00 UTC"]},
    {"unit": "trading-data-backup.service", "origin": "external", "managed_by": "trading-data", "state": "enabled",
     "activation": "timer", "timer": "trading-data-backup.timer", "max_runtime": "2h", "window_minutes": 130,
     "store": {"access": "reader", "writes": [], "reads": ["store/market.duckdb"], "windows": "schedule"}},

    {"unit": "live-287-signal.timer", "origin": "external", "managed_by": "trading-alpha", "state": "enabled",
     "service": "live-287-signal.service", "calendar": ["Mon..Fri *-*-* 09:25:00 America/New_York"]},
    {"unit": "live-287-signal.service", "origin": "external", "managed_by": "trading-alpha", "state": "enabled",
     "activation": "timer", "timer": "live-287-signal.timer", "max_runtime": "5min",
     "store": {"access": "reader", "writes": [], "reads": ["store/pit/free-sources.duckdb"], "windows": "schedule"}},
    {"unit": "live-287-settle.timer", "origin": "external", "managed_by": "trading-alpha", "state": "enabled",
     "service": "live-287-settle.service",
     "calendar": ["Tue..Sat *-*-* 07:40:00 UTC", "Tue..Sat *-*-* 11:50:00 UTC"]},
    {"unit": "live-287-settle.service", "origin": "external", "managed_by": "trading-alpha", "state": "enabled",
     "activation": "timer", "timer": "live-287-settle.timer", "max_runtime": "4h",
     "store": {"access": "reader", "writes": [], "reads": ["store/pit/free-sources.duckdb"], "windows": "schedule"}},
    {"unit": "live-287-report.service", "origin": "external", "managed_by": "trading-alpha", "state": "enabled",
     "activation": "manual", "max_runtime": "5min",
     "store": {"access": "reader", "writes": [], "reads": ["store/pit/free-sources.duckdb"], "windows": "always"}},
    {"unit": "confirm-287.timer", "origin": "external", "managed_by": "trading-alpha", "state": "enabled",
     "service": "confirm-287.service", "calendar": ["*-*-03 06:30:00 UTC"]},
    {"unit": "confirm-287.service", "origin": "external", "managed_by": "trading-alpha", "state": "enabled",
     "activation": "timer", "timer": "confirm-287.timer", "max_runtime": "12h",
     "store": {"access": "reader", "writes": [], "reads": ["store/pit/free-sources.duckdb"], "windows": "schedule"}},
    {"unit": "alpha.slice", "origin": "external", "managed_by": "operator", "state": "enabled",
     "activation": "slice", "max_runtime": null, "store": {"access": "none"}},

    {"unit": "store-sync.timer", "origin": "external", "managed_by": "personal-data-store", "state": "enabled",
     "service": "store-sync.service", "calendar": []},
    {"unit": "store-sync.service", "origin": "external", "managed_by": "personal-data-store", "state": "enabled",
     "activation": "timer", "timer": "store-sync.timer", "max_runtime": null, "store": {"access": "none"}},
    {"unit": "te-autopush.timer", "origin": "external", "managed_by": "operator", "state": "enabled",
     "service": "te-autopush.service", "calendar": []},
    {"unit": "te-autopush.service", "origin": "external", "managed_by": "operator", "state": "enabled",
     "activation": "timer", "timer": "te-autopush.timer", "max_runtime": null, "store": {"access": "none"}},
    {"unit": "trae-proxy.service", "origin": "external", "managed_by": "operator", "state": "enabled",
     "activation": "boot", "max_runtime": null, "store": {"access": "none"}}
  ],
  "cron": [
    {"name": "run_daily", "origin": "repo", "state": "enabled", "schedule": "30 22 * * 1-5",
     "match": "{engine}/engine/run_daily.sh", "max_runtime": "6h",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},
    {"name": "run_weekly_verify", "origin": "repo", "state": "enabled", "schedule": "0 2 * * 6",
     "match": "{engine}/engine/run_weekly_verify.sh", "max_runtime": "4h",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},
    {"name": "run_weekend_sweeps", "origin": "repo", "state": "enabled", "schedule": "0 6 * * 6",
     "match": "{engine}/engine/run_weekend_sweeps.sh", "max_runtime": "24h",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},
    {"name": "run_weekly_liquid", "origin": "repo", "state": "enabled", "schedule": "0 2 * * 0",
     "match": "{engine}/engine/run_weekly_liquid.sh", "max_runtime": "4h",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},
    {"name": "run_weekly_walkforward", "origin": "repo", "state": "enabled", "schedule": "0 6 * * 0",
     "match": "{engine}/engine/run_weekly_walkforward.sh", "max_runtime": "18h",
     "store": {"access": "writer", "writes": ["store/market.duckdb"], "reads": [], "windows": "schedule"}},
    {"name": "friday_postflight", "origin": "repo", "state": "enabled", "schedule": "15 5 * * 6",
     "match": "cd {engine} && .venv/bin/python -m tools.verify_friday_postflight", "max_runtime": "30min",
     "store": {"access": "none"}},
    {"name": "news_scraper_boot", "origin": "external", "managed_by": "operator", "state": "enabled",
     "schedule": "@reboot", "match": "{home}/news-scraper/ensure_scraper.sh", "max_runtime": null,
     "store": {"access": "none"}},
    {"name": "news_scraper_watchdog", "origin": "external", "managed_by": "operator", "state": "enabled",
     "schedule": "17 * * * *", "match": "{home}/news-scraper/ensure_scraper.sh", "max_runtime": null,
     "store": {"access": "none"}}
  ]
}
