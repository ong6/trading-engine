[Unit]
Description=Trading engine P15 nightly candidate scoring
After=network-online.target trae-proxy.service
Wants=network-online.target trae-proxy.service
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/server/run_p15_scoring.sh
Environment=PYTHONUNBUFFERED=1
Environment=TRADING_ENGINE_DUCKDB_THREADS=8
Environment=TRADING_ENGINE_DUCKDB_MEMORY_LIMIT=8GB
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=9h
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=5min
