[Unit]
Description=Trading engine publish-on-change of the read-only store generation

[Service]
Type=oneshot
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/.venv/bin/python -m tools.publish_snapshot --if-changed
Environment=PYTHONUNBUFFERED=1
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=25min
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
