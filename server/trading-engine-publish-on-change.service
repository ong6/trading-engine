[Unit]
Description=Trading engine publish-on-change of the read-only store generation

[Service]
Type=oneshot
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/.venv/bin/python -m tools.publish_snapshot --if-changed
Environment=PYTHONUNBUFFERED=1
Nice=19
IOSchedulingClass=best-effort
# Recorded full publications took about 29 minutes; allow 16 minutes of load margin.
TimeoutStartSec=45min
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
