[Unit]
Description=Trading engine cron driver watchdog

[Service]
Type=oneshot
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/.venv/bin/python -m tools.driver_watchdog
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=10min
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
