[Unit]
Description=Trading engine daily opportunity assessment
After=network-online.target trae-proxy.service
Wants=network-online.target trae-proxy.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/server/run_daily_opportunity.sh
Environment=PYTHONUNBUFFERED=1
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=10min
# systemd 241 stops applying TimeoutStartSec to Type=exec once exec succeeds.
RuntimeMaxSec=10min
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=5min
