[Unit]
Description=Trading engine daily opportunity assessment
After=network-online.target trae-proxy.service
Wants=network-online.target trae-proxy.service
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/server/run_daily_opportunity.sh
Environment=PYTHONUNBUFFERED=1
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=10min
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
Restart=on-failure
RestartSec=5min
