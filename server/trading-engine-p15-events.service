[Unit]
Description=Trading engine P15 shadow event scoring
After=network-online.target trae-proxy.service
Wants=network-online.target trae-proxy.service

[Service]
Type=oneshot
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/.venv/bin/python -m farm.p15_event_runner --run
Environment=PYTHONUNBUFFERED=1
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=14min
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
