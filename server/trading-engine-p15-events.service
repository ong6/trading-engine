[Unit]
Description=Trading engine P15 shadow event scoring
After=network-online.target trae-proxy.service
Wants=network-online.target trae-proxy.service

[Service]
Type=oneshot
WorkingDirectory=%h/trading-engine
ExecStart=%h/trading-engine/.venv/bin/python -m farm.p15_event_runner --run
ExecStartPost=-%h/trading-engine/.venv/bin/python -m tools.publish_snapshot --min-age-minutes 120
Environment=PYTHONUNBUFFERED=1
Environment=TRADING_ENGINE_DUCKDB_THREADS=8
Environment=TRADING_ENGINE_DUCKDB_MEMORY_LIMIT=8GB
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=14min
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
UMask=0077
